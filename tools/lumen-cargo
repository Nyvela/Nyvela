#!/bin/sh
set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER="$tool_dir/lumen-clang"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS='-C relocation-model=static -C target-feature=+crt-static -C link-self-contained=no'
export CC_x86_64_unknown_linux_musl="${CC_x86_64_unknown_linux_musl:-$tool_dir/lumen-clang}"
command=${1:-build}
if [ "$#" -gt 0 ]; then
    shift
fi
exec "${CARGO:-cargo}" "$command" --target x86_64-unknown-linux-musl "$@"
