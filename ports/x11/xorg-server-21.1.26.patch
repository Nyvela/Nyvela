+const void *
+lumen_x11_framebuffer(size_t *stride);
+
+const void *
+lumen_x11_framebuffer(size_t *stride)
+{
+    ScreenPtr screen = screenInfo.numScreens == 1 ? screenInfo.screens[0] : NULL;
+    if (!screen || screen->width != 640 || screen->height != 400 ||
+        screen->rootDepth != 24)
+        return NULL;
+    PixmapPtr pixmap = screen->GetScreenPixmap(screen);
+    *stride = pixmap->devKind / sizeof(CARD32);
+    return pixmap->devPrivate.ptr;
+}
+#endif
