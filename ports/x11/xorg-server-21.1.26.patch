--- a/hw/vfb/InitInput.c
+++ b/hw/vfb/InitInput.c
@@ -126,0 +127,52 @@
+#ifdef __lumen__
+#include <stdint.h>
+#include "inpututils.h"
+
+extern int64_t lumen_x11_acquire(void);
+extern unsigned lumen_x11_key(void);
+extern int64_t lumen_x11_pointer(int *dx, int *dy, unsigned *buttons);
+extern const void *lumen_x11_framebuffer(size_t *stride);
+extern void lumen_x11_present(const void *pixels, size_t stride);
+
+static DeviceIntPtr lumen_pointer, lumen_keyboard;
+static OsTimerPtr lumen_timer;
+static unsigned lumen_buttons;
+
+static CARD32
+lumen_seat_tick(OsTimerPtr timer, CARD32 now, void *data)
+{
+    int dx, dy;
+    unsigned event, buttons;
+    ValuatorMask mask;
+    size_t stride;
+    const void *pixels;
+
+    while ((event = lumen_x11_key()) != 0) {
+        if (event != 1)
+            QueueKeyboardEvents(lumen_keyboard, event & 0x100 ? KeyPress : KeyRelease,
+                                event & 0xff);
+    }
+    while (lumen_x11_pointer(&dx, &dy, &buttons) > 0) {
+        static const int button_map[] = { 1, 3, 2 };
+        if (dx || dy) {
+            const int delta[] = { dx, dy };
+            valuator_mask_set_range(&mask, 0, 2, delta);
+            QueuePointerEvents(lumen_pointer, MotionNotify, 0, POINTER_RELATIVE, &mask);
+        }
+        for (int i = 0; i < 3; i++) {
+            unsigned bit = 1U << i;
+            if ((lumen_buttons ^ buttons) & bit) {
+                valuator_mask_zero(&mask);
+                QueuePointerEvents(lumen_pointer, buttons & bit ? ButtonPress : ButtonRelease,
+                                   button_map[i], POINTER_RELATIVE, &mask);
+            }
+        }
+        lumen_buttons = buttons;
+    }
+    pixels = lumen_x11_framebuffer(&stride);
+    if (pixels)
+        lumen_x11_present(pixels, stride);
+    return 20;
+}
+#endif
+
